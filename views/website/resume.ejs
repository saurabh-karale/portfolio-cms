<%- include('header.ejs'); %>
    <!-- ===== RESUME / SKILLS SECTION ===== -->
    <section id="resume" class="resume">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">SKILLS & EXPERIENCE</span>
                <h2 class="section-title">Technical Skills &amp; Professional Experience</h2>
                <p class="section-desc">A showcase of technical skills, experience and educational background.</p>
            </div>

            <div class="resume-grid">
                <!-- Technical Skills -->
                <div class="skills-container">
                    <h3>Technical Skills</h3>
                    <% for ( var i=0;i<skill.length;i++) { %>
                        <div class="skill-item">
                            <div class="skill-header">
                                <span class="skill-name">
                                    <%= skill[i].tech_name %>
                                </span>
                                <span class="skill-percent">
                                    <%= skill[i].tect_per %>%
                                </span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" data-width="<%= skill[i].tect_per %>"></div>
                            </div>
                        </div>
                        <% } %>
                </div>

                <!-- Experience Timeline -->
                <d iv class="timeline-container">
                    <h3>Experience</h3>

                    <div class="timeline">
                        <% for (var a=0;a<experience.length;a++) { %>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <span class="timeline-date">
                                        <%=experience[a].exp_duration %>
                                    </span>
                                    <h4>
                                        <%=experience[a].exp_position %>
                                    </h4>
                                    <p class="timeline-company">
                                        <%=experience[a].exp_company %>
                                    </p>
                                    <p>
                                        <%=experience[a].exp_desc %>
                                    </p>
                                </div>
                            </div>
                            <% } %>
                    </div>

                    <h3 style="margin-top: 40px;">Education</h3>
                    <div class="timeline">
                        <% for (var e=0; e < education.length; e++) { %>

                            <div class="timeline-item">
                                <div class="timeline-dot"></div>

                                <div class="timeline-content">
                                    <span class="timeline-date">
                                        <%= education[e].edu_duration %>
                                    </span>

                                    <h4>
                                        <%= education[e].edu_position %>
                                    </h4>

                                    <p class="timeline-company">
                                        <%= education[e].edu_company %>
                                    </p>
                                </div>
                            </div>

                            <% } %>
                    </div>
            </div>
        </div>
        </div>
    </section>
    <%- include('footer.ejs'); %>
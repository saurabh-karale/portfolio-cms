<%- include('header.ejs'); %>
 <!-- ===== CONTACT SECTION ===== -->
    <section id="contact" class="contact">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Contact</span>
                <h2 class="section-title">Let's Work Together</h2>
                <p class="section-desc">Have a project in mind? Let's bring it to life</p>
            </div>
            
            <div class="contact-grid">
                <div class="contact-info">
                    <div class="contact-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <div>
                            <h4>Location</h4>
                            <p>Maharashtra</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-envelope"></i>
                        <div>
                            <h4>Email</h4>
                            <p>developer@example.com</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-phone"></i>
                        <div>
                            <h4>Phone</h4>
                            <p>+91 9999999909</p>
                        </div>
                    </div>
                    
                    <!-- Google Map Placeholder -->
                    <div class="map-placeholder">
                        <iframe 
                            src="<%=contact.map%>" 
                            width="100%" 
                            height="200" 
                            style="border:0; border-radius: 12px;" 
                            allowfullscreen="" 
                            loading="lazy">
                        </iframe>
                    </div>
                </div>
                
                <!-- Contact Form -->
                <div class="contact-form-container">
                    <form id="" action="/contact_form_save"  method="post">
                        <div class="form-group">
                            <label for="name">Full Name</label>
                            <input type="text" id="name" name="full_name" placeholder="John Doe"  />
                            <span class="error-message" id="nameError">Please enter your name</span>
                        </div>
                        
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" placeholder="john@example.com"  />
                            <span class="error-message" id="emailError">Please enter a valid email</span>
                        </div>
                        
                        <div class="form-group">
                            <label for="subject">Subject</label>
                            <input type="text" id="subject" name="subject" placeholder="Project Inquiry" />
                        </div>
                        
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message" rows="5" name="message" placeholder="Tell me about your project..." ></textarea>
                            <span class="error-message" id="messageError">Please enter your message</span>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
<%- include('footer.ejs'); %>
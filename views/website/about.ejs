<%- include('header.ejs'); %>
<!-- ===== ABOUT SECTION ===== -->
    <section id="about" class="about">
        <div class="container">
            <% for(var i=0;i<data.length;i++){%>
            <div class="section-header">
                <span class="section-tag">About Me</span>
                <h2 class="section-title"><%=data[i].title%></h2>
                <p class="section-desc"><%=data[i].subtitle%></p>
            </div>
            
            <div class="about-grid">
              
                <div class="about-image">
                    <img src="<%=data[i].image%>" alt="about-image"/>
                    <div class="about-experience-badge">
                        <span>6+</span>
                        Years Experience
                    </div>
                </div>
                <div class="about-content">
                    <h3><%=data[i].position%></h3>
                    <p><%=data[i].position_desc%></p>
                    
                    <div class="about-info-grid">
                        <div class="info-item">
                            <span class="info-label">Name:</span>
                            <span class="info-value"><%=data[i].name%></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Email:</span>
                            <span class="info-value"><%=data[i].email%></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Location:</span>
                            <span class="info-value"><%=data[i].location%></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Freelance:</span>
                            <span class="info-value"><%=data[i].freelance%></span>
                        </div>
                    </div>
                    
                    <a href="/contact" class="btn btn-primary">Get In Touch</a>
                </div>
            </div>
           
        </div>
    </section>

       <section class="statistics">
        <div class="container">
            <div class="stat-grid">
                <div class="stat-item">
                    <span class="stat-number" data-count="120"><%=data[i].projects_completed%></span>
                    <span class="stat-label">Projects Completed</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number" data-count="85"><%=data[i].happy_clients%></span>
                    <span class="stat-label">Happy Clients</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number" data-count="15"><%=data[i].awards_won%></span>
                    <span class="stat-label">Awards Won</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number" data-count="4"><%=data[i].years_experience%></span>
                    <span class="stat-label">Years Experience</span>
                </div>
            </div>
            <% } %>
        </div>
    </section>
<%- include('footer.ejs'); %>
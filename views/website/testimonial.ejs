<%- include('header.ejs'); %>

    <!-- ===== TESTIMONIALS SLIDER ===== -->
    <section class="testimonials">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Testimonials</span>
                <h2 class="section-title">What Clients Say</h2>
            </div>

            <div class="testimonial-slider">
                <div class="testimonial-track" id="testimonialTrack">

                    <% for(var i=0;i<testimonials.length;i++){ %>

                        <div class="testimonial-card">

                            <div class="testimonial-stars">
                                <%= testimonials[i].test_star %>
                            </div>

                            <p class="testimonial-text">
                                <%= testimonials[i].test_desc %>
                            </p>

                            <div class="testimonial-author">

                                <img src="/<%= testimonials[i].test_img %>" alt="<%= testimonials[i].test_name %>">

                                <div class="author-info">

                                    <h4>
                                        <%= testimonials[i].test_name %>
                                    </h4>

                                    <span>
                                        <%= testimonials[i].test_position %>
                                    </span>

                                </div>

                            </div>

                        </div>

                        <% } %>

                </div>

                <!-- Slider Controls -->
                <div class="slider-controls">
                    <button class="slider-btn" id="prevTestimonial"><i class="fas fa-chevron-left"></i></button>
                    <div class="slider-dots" id="testimonialDots">
                        <span class="dot active"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                    </div>
                    <button class="slider-btn" id="nextTestimonial"><i class="fas fa-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </section>
    <%- include('footer.ejs'); %>
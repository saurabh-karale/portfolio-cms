<%- include('header.ejs'); %>

<div class="page-content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="page-header mb-4">
            <h1 class="h3 mb-1">Project Information</h1>
            <p class="text-muted small mb-0">
                Basic information about this portfolio project
            </p>
        </div>

        <!-- Project Information -->
        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <div class="row g-3">

                    <!-- Project Name -->
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block mb-1">
                                Project Name
                            </small>
                            <h6 class="mb-0">
                                Personal Portfolio Website
                            </h6>
                        </div>
                    </div>

                    <!-- Project Type -->
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block mb-1">
                                Project Type
                            </small>
                            <h6 class="mb-0">
                                Full Stack Web Application
                            </h6>
                        </div>
                    </div>

                    <!-- Technology Used -->
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block mb-1">
                                Technology Used
                            </small>
                            <h6 class="mb-0">
                                HTML5, CSS3, JavaScript, Bootstrap, Font Awesome, Node.js, Express.js, EJS, MySQL
                            </h6>
                        </div>
                    </div>

                    <!-- Project Purpose -->
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block mb-1">
                                Project Purpose
                            </small>
                            <h6 class="mb-0">
                                Personal Portfolio Management
                            </h6>
                        </div>
                    </div>

                    <!-- Project Status -->
                    <div class="col-12">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block mb-1">
                                Project Status
                            </small>

                            <span class="badge bg-success">
                                Active
                            </span>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>
</div>

<%- include('footer.ejs'); %>
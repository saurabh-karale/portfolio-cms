<%- include('header.ejs'); %>


    <!-- ===== DASHBOARD CONTENT ===== -->
    <div class="page-content">
        <div class="container-fluid">
            <!-- Page Header -->
            <div class="page-header d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1">Testimonial List </h1>
                    <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
                </div>

            </div>

            <!-- Stat Cards -->
            <div class="row g-4">
                <div class="col-12">
                    <table border="1" class="table table-border">

                        <tr>
                            <th>ID</th>
                            <th>Testimonial Star</th>
                            <th>Testimonial Description</th>
                            <th>Testimonial Image</th>
                            <th>Testimonial Name</th>
                            <th>Testimonial Position</th>
                            <th>Status</th>
                        </tr>
                        <% for ( var i=0;i<testimonials.length;i++){ %>
                            <tr>
                                <td>
                                    <%= i+1 %>
                                </td>
                                <td>
                                    <%= testimonials[i].test_star %>
                                </td>
                                <td>
                                    <%= testimonials[i].test_desc %>
                                </td>
                                <td>
                                    <%= testimonials[i].test_img %>
                                </td>
                                <td>
                                    <%= testimonials[i].test_name %>
                                </td>
                                <td>
                                    <%= testimonials[i].test_position %>
                                </td>
                                <td>
                                    <a href="/admin/testimonials_delete/<%= testimonials[i].id %>">
                                        <button class="btn btn-danger">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </a>

                                    <a href="/admin/testimonials_edit/<%= testimonials[i].id %>">
                                        <button class="btn btn-warning">
                                            <i class="fa fa-pencil"></i>
                                        </button>
                                    </a>
                                </td>
                            </tr>
                            <% } %>
                    </table>

                </div>
            </div>



        </div>
    </div>
    <%- include('footer.ejs'); %>
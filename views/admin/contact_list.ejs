<%- include('header.ejs'); %>

    <div class="page-content">
        <div class="container-fluid">

            <div class="page-header d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1">Contact List</h1>
                    <p class="text-muted small mb-0">All Contact Messages</p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12">

                    <table class="table table-bordered">

                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Subject</th>
                            <th>Message</th>
                            <th>Action</th>
                        </tr>
                        <% for(var i=0;i<contact.length;i++){ %>

                            <tr>
                                <td>
                                    <%= contact[i].cid %>
                                </td>
                                <td>
                                    <%= contact[i].c_name %>
                                </td>
                                <td>
                                    <%= contact[i].c_email %>
                                </td>
                                <td>
                                    <%= contact[i].c_subject %>
                                </td>
                                <td>
                                    <%= contact[i].c_message %>
                                </td>
                                <td>
                                    <a href="/admin/contact_delete/<%= contact[i].cid %>">
                                        <button class="btn btn-danger">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </a>

                                    <a href="/admin/contact_edit/<%= contact[i].cid %>">
                                        <button class="btn btn-warning">
                                            <i class="fa fa-pencil"></i>
                                        </button>
                                    </a>
                                </td>
                            </tr>

                            <% } %>
                    </table>

                </div>
            </div>

        </div>
    </div>

    <%- include('footer.ejs'); %>
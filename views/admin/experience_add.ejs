<%- include('header.ejs'); %>


    <!-- ===== DASHBOARD CONTENT ===== -->
    <div class="page-content">
        <div class="container-fluid">
            <!-- Page Header -->
            <div class="page-header d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1">Add Experience</h1>
                    <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
                </div>
                
            </div>

            <!-- Stat Cards -->
            <div class="row g-4">
                <div class="col-12">
                    <form action="/admin/experience_add_save" method="post">
                        <label>Experience Duration (Y-Y)</label>
                        <input type="text" name="exp_duration" class="form-control mb-4">
                        <label>Experience Position</label>
                        <input type="text" name="exp_position" class="form-control  mb-4">
                        <label>Experience Company</label>
                        <input type="text" name="exp_company" class="form-control  mb-4">
                        <label>Experience Description</label>
                        <input type="text" name="exp_desc" class="form-control  mb-4">
                        <button class="btn btn-primary">Save</button>
                    </form>

                </div>
            </div>



        </div>
    </div>
    <%- include('footer.ejs'); %>
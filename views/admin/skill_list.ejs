<%- include('header.ejs'); %>


    <!-- ===== DASHBOARD CONTENT ===== -->
    <div class="page-content">
        <div class="container-fluid">
            <!-- Page Header -->
            <div class="page-header d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1">Skill List </h1>
                    <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
                </div>

            </div>

            <!-- Stat Cards -->
            <div class="row g-4">
                <div class="col-12">
                    <table border="1" class="table table-border">

                        <tr>
                            <th>ID</th>
                            <th>Technology Name</th>
                            <th>Technology Per(%)</th>
                            <th>Status</th>
                        </tr>
                        <% for ( var i=0;i<skill.length;i++){ %>
                            <tr>
                                <th>
                                    <%= i+1 %>
                                </th>
                                <th>
                                    <%= skill[i].tech_name %>
                                </th>
                                <th>
                                    <%= skill[i].tect_per %>
                                </th>
                    
                                <th>
                                    <a href="/admin/skill_delete/<%= skill[i].ts_id %>">
                                        <button class="btn btn-danger">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </a>

                                    <a href="/admin/skill_edit/<%= skill[i].ts_id %>">
                                        <button class="btn btn-warning">
                                            <i class="fa fa-pencil"></i>
                                        </button>
                                    </a>
                                </th>
                            </tr>
                            <% } %>
                    </table>

                </div>
            </div>



        </div>
    </div>
    <%- include('footer.ejs'); %>
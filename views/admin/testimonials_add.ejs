<%- include('header.ejs'); %>


    <!-- ===== DASHBOARD CONTENT ===== -->
    <div class="page-content">
        <div class="container-fluid">
            <!-- Page Header -->
            <div class="page-header d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1">Add testimonials</h1>
                    <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
                </div>
                
            </div>

            <!-- Stat Cards -->
            <div class="row g-4">
                <div class="col-12">
                    <form action="/admin/testimonials_add_save" method="post">
                        <label>Testimonials Star</label>
                        <input type="text" name="test_star" class="form-control mb-4">
                        <label>Testimonials Description</label>
                        <input type="text" name="test_desc" class="form-control  mb-4">
                        <label>Testimonials Image</label>
                        <input type="text" name="test_img" class="form-control  mb-4">
                        <label>Testimonials Name</label>
                        <input type="text" name="test_name" class="form-control  mb-4">
                        <label>Testimonials Position</label>
                        <input type="text" name="test_position" class="form-control  mb-4">
                        <button class="btn btn-primary">Save</button>
                    </form>

                </div>
            </div>



        </div>
    </div>
    <%- include('footer.ejs'); %>